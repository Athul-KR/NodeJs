{
  "name": "auth-api",
  "version": "1.0.0",
  "description": "Login & registration API — layered architecture study project (routes → controllers → services → repositories)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:create": "sequelize-cli db:create",
    "db:drop": "sequelize-cli db:drop",
    "migrate": "sequelize-cli db:migrate",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migrate:rollback": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "seed:rollback": "sequelize-cli db:seed:undo",
    "test": "vitest run"
  },
  "author": "Athul",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.14.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sequelize": "^6.37.8",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.0.0",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.1.0",
    "vitest": "^3.1.1"
  }
}
